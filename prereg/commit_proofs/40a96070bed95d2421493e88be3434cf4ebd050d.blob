RUNS_HOSTED = ["C1", "C2", "C3", "P1", "P2", "M1", "T1", "K1"]
RUNS_LOCAL = ["C1", "C2", "C3", "P1", "P2", "M1", "T1", "K1"]
UU_TIEN_LOCAL = ["golden", "C1", "P2", "M1", "P1", "C2", "K1", "T1", "C3"]   # V2-08 (d): bỏ từ cuối khi thiếu giờ
OLLAMA_A = "0.30.10"
OLLAMA_B = "0.40.16"
M1_HOSTED = "gemini-2.5-flash-lite"
M1_LOCAL = "qwen2.5:7b"
